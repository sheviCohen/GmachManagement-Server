<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="layout"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger:shortName=true}|${message}${onexception:inner=|${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${layout}" />
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/gmach-${shortdate}.log"
            layout="${layout}"
            encoding="utf-8"
            keepFileOpen="false"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <!-- הודעות רגילות של המערכת (EF, ASP.NET) רק מרמת Warning, כדי שלא יציפו את הלוג -->
    <!-- הודעות ההפעלה ("Now listening on", "Application started") נשארות -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
